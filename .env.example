# RentBuyStay landing — API integration config
# Copy to .env.local and fill in real values. Anything prefixed NEXT_PUBLIC_ is
# inlined into the client bundle, so never put secrets here.

# Base URL of the RentBuyStay backend API (no trailing slash, no path prefix —
# endpoints are root-level like /auth/login and /me).
# Docs: http://153.75.226.46:8080/swagger-ui/index.html  |  http://153.75.226.46:8080/scalar
NEXT_PUBLIC_API_BASE_URL=http://153.75.226.46:8080

# Dashboard app URL (the APP frontend, not the API).
NEXT_PUBLIC_APP_URL=https://rentbuystay-app.vercel.app

# Single sign-on. false = cross-domain hand-off (default); true = shared session
# (both apps on *.rentbuystay.com with the API cookie scoped to .rentbuystay.com).
NEXT_PUBLIC_SSO_ENABLED=false
